# Only application source and reviewed runtime assets enter the build context.
**
!pyproject.toml
!README.md
!LICENSE
!voicemem/
!voicemem/**
!studio/
!studio/**
!prompt/
!prompt/*.md
!prompt/*.json
!voice/
voice/**
!voice/noctelle_ref_short.wav
!voice/noctelle_ref_short.txt
!voice/backchannel/
!voice/backchannel/*.wav
!docker/
!docker/Dockerfile.cuda
!docker/smoke_check.py

# Explicit exclusions also protect against files placed inside source folders.
**/.git
**/.env
**/.env.*
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/node_modules
**/.venv*
**/*.onnx
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.bin
studio/models
# The desktop app is distributed separately; retain only the Python package marker.
studio/apps/**
!studio/apps/__init__.py
prompt/logs
results
voicemem_memoryspace
models
cache
