# Copy to .env. Exported environment values take precedence over this file.
DEEPSEEK_API_KEY=      # Only for --llm openai/local or --mode realtime
# DASHSCOPE_API_KEY=    # Only for --llm qwen

# Startup flags override these options. Defaults work with sibling Breeze repos.
# STUDIO_BACKEND=cuda
# STUDIO_DEVICE=cuda:0
# STUDIO_TTS_DEVICE=cuda:0
# STUDIO_MODELS_DIR=/path/to/VoiceMem-Studio/studio/models
# BREEZE_CODE_DIR=/path/to/breeze-tts
# BREEZE_MODEL_DIR=/path/to/breeze-tts-2
# STUDIO_DESKTOP_PET=0                    # Native: disable Electron; Docker always disables it

# Docker-only host binding; container-internal model paths and GPU 0 are fixed by Compose.
# STUDIO_PORT=8787
# STUDIO_BIND_HOST=127.0.0.1
# TZ=Asia/Shanghai

# Optional server-side Interax SDK integration (llm_tts: deepseek/qwen/openai).
# Leave the URL empty to disable. Requires Node.js >=22.12 and the upstream sources.
# This URL is passed to InteraxClient.baseUrl, including any reverse-proxy prefix.
STUDIO_INTERAX_BASE_URL=
# STUDIO_INTERAX_BASE_URL=http://127.0.0.1:8100/
# Defaults to the sibling Interax checkout; use an absolute path for other layouts.
# STUDIO_INTERAX_ROOT=/path/to/Interax
# INTERAX_BASE_URL and INTERAX_API_KEY configure Interax's model provider, not this client.
